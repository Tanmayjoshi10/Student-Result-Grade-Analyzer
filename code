
#include <stdio.h>
#include <string.h>

#define MAX_STUDENTS 100
#define SUBJECTS 5
#define PASS_MARKS 33

char subjectNames[SUBJECTS][20] = {
    "English", "Maths", "Physics",
    "Chemistry", "Computer"
};

struct Student {
    char name[50];
    int marks[SUBJECTS];
    int total;
    float percentage;
    char grade[3];
    char status[10];
};

void calculateResult(struct Student *s) {

    s->total = 0;
    int passed = 1;

    for (int i = 0; i < SUBJECTS; i++) {
        s->total += s->marks[i];

        if (s->marks[i] < PASS_MARKS) {
            passed = 0;
        }
    }

    s->percentage = s->total / 5.0;

    if (s->percentage >= 90)
        strcpy(s->grade, "A+");
    else if (s->percentage >= 80)
        strcpy(s->grade, "A");
    else if (s->percentage >= 70)
        strcpy(s->grade, "B");
    else if (s->percentage >= 60)
        strcpy(s->grade, "C");
    else if (s->percentage >= 50)
        strcpy(s->grade, "D");
    else if (s->percentage >= 33)
        strcpy(s->grade, "E");
    else
        strcpy(s->grade, "F");

    if (passed)
        strcpy(s->status, "PASS");
    else
        strcpy(s->status, "FAIL");
}

void displayStudent(struct Student s) {

    printf("\n----------------------------------\n");
    printf("Student Name: %s\n", s.name);

    for (int i = 0; i < SUBJECTS; i++) {
        printf("%-12s : %d/100\n",
               subjectNames[i], s.marks[i]);
    }

    printf("----------------------------------\n");
    printf("Total       : %d/500\n", s.total);
    printf("Percentage  : %.2f%%\n", s.percentage);
    printf("Grade       : %s\n", s.grade);
    printf("Status      : %s\n", s.status);
}

int main() {

    struct Student students[MAX_STUDENTS];
    int n;
    int topper = 0;
    int passed = 0, failed = 0;
    float classTotal = 0;

    printf("====================================\n");
    printf(" STUDENT RESULT AND GRADE ANALYZER\n");
    printf("====================================\n");

    printf("Enter number of students (1-100): ");
    scanf("%d", &n);

    if (n < 1 || n > MAX_STUDENTS) {
        printf("Invalid number of students!\n");
        return 1;
    }

    // Input student details
    for (int i = 0; i < n; i++) {

        printf("\nEnter details of Student %d\n", i + 1);

        printf("Enter student name: ");
        scanf(" %49[^\n]", students[i].name);

        for (int j = 0; j < SUBJECTS; j++) {

            do {
                printf("Enter %s marks (0-100): ",
                       subjectNames[j]);

                scanf("%d", &students[i].marks[j]);

                if (students[i].marks[j] < 0 ||
                    students[i].marks[j] > 100) {
                    printf("Invalid marks! Try again.\n");
                }

            } while (students[i].marks[j] < 0 ||
                     students[i].marks[j] > 100);
        }

        calculateResult(&students[i]);

        classTotal += students[i].percentage;

        if (strcmp(students[i].status, "PASS") == 0)
            passed++;
        else
            failed++;

        if (students[i].total > students[topper].total)
            topper = i;
    }

    // Display individual results
    printf("\n\n========== STUDENT RESULTS ==========\n");

    for (int i = 0; i < n; i++) {
        displayStudent(students[i]);
    }

    // Class performance report
    printf("\n\n====================================\n");
    printf("      CLASS PERFORMANCE REPORT\n");
    printf("====================================\n");

    printf("Total Students : %d\n", n);
    printf("Class Topper   : %s\n",
           students[topper].name);

    printf("Topper Marks   : %d/500\n",
           students[topper].total);

    printf("Topper Percent : %.2f%%\n",
           students[topper].percentage);

    printf("Class Average  : %.2f%%\n",
           classTotal / n);

    printf("Students Passed: %d\n", passed);
    printf("Students Failed: %d\n", failed);

    printf("====================================\n");
    printf("       ANALYSIS COMPLETED!\n");
    printf("====================================\n");

    return 0;
}
